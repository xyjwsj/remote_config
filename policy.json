{
  "version": "2024.05.08-002",
  "updatedAt": "2024-05-08T12:00:00Z",
  "rules": {
    "adSelectors": [
      "ins.adsbygoogle",
      ".ads-ad",
      ".commercial-unit",
      ".ec_ad_results",
      ".c-container > .c-showurl",
      "#content_left > div[style*=\"display:block !important\"]",
      "iframe[src*=\"googlesyndication\"]",
      "iframe[src*=\"doubleclick\"]",
      "iframe[src*=\"googleadservices\"]",
      "iframe[src*=\"facebook.com/tr\"]",
      "iframe[data-src*=\"googlesyndication\"]",
      "iframe[data-src*=\"doubleclick\"]",
      "[data-ad-slot]",
      "[data-ad-client]",
      ".video-ads",
      ".ytp-ad-module",
      ".ytp-ad-overlay",
      ".modal-ad",
      ".popup-ad",
      ".float-ad",
      ".lim-ad",
      ".wwads",
      "[class^=\"wwads-\"]",
      ".outbrain",
      ".taboola",
      ".popads",
      ".yandex"
    ],
    "popupSelectors": [
      ".login-modal",
      ".register-modal",
      ".signin-popup",
      "[class*=\"force-login\"]",
      "[class*=\"must-login\"]",
      "[class*=\"coupon-popup\"]",
      "[class*=\"redpacket\"]",
      "[class*=\"lucky-draw\"]",
      ".fixed-bottom-ad",
      ".fixed-right-ad",
      ".float-btn-ad"
    ],
    "trapSelectors": [
      ".fake-close",
      "[class*=\"fake-download\"]",
      "[class*=\"trap-download\"]",
      "[class*=\"follow-btn\"][class*=\"trap\"]",
      "[class*=\"subscribe\"][onclick*=\"wx\"]",
      "[class*=\"sexy\"]",
      "[class*=\"adult\"]",
      "[title*=\"性感\"]",
      "[title*=\"诱惑\"]",
      "[class*=\"casino\"]",
      "[class*=\"lottery\"][class*=\"trap\"]",
      "a[onclick*=\"ad\"]",
      "button[onclick*=\"ad\"]",
      "[data-click*=\"ad\"]",
      "[class*=\"auto-jump\"]",
      "[data-autojump=\"true\"]"
    ],
    "trackerSelectors": [
      "img[width=\"1\"][height=\"1\"]",
      "img[width=\"0\"][height=\"0\"]",
      "iframe[style*=\"display:none\"]",
      "iframe[style*=\"visibility:hidden\"]"
    ],
    "domainBlacklist": [
      "doubleclick.net",
      "googleadservices.com",
      "googlesyndication.com",
      "googletagmanager.com",
      "google-analytics.com",
      "facebook.com/tr",
      "amazon-adsystem.com",
      "adsystem.amazon.com",
      "outbrain.com",
      "taboola.com",
      "popads.net"
    ],
    "urlPatterns": [
      {
        "pattern": ".*\\.googleadservices\\.com.*",
        "type": "ad",
        "description": "Google Ads 服务"
      },
      {
        "pattern": ".*\\.doubleclick\\.net.*",
        "type": "ad",
        "description": "DoubleClick 广告"
      }
    ]
  },
  "exceptions": [
    {
      "domain": "example.com",
      "reason": "测试用可信站点"
    }
  ]
}
